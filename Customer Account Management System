
#include <iostream>
#include <iomanip>
#include <string>
#include <limits>

using namespace std;

const int SIZE = 10;

// ============================================================
// CUSTOMER ACCOUNT CLASS
// ============================================================

class CustomerAccount
{
private:
    int accountNumber;
    string name;
    string address;
    string cityStateZip;
    string phone;
    double balance;
    string lastPaymentDate;
    bool active;

public:

    // Constructor
    CustomerAccount()
    {
        accountNumber = 0;
        balance = 0.0;
        active = false;
    }

    // --------------------------------------------------------
    // CREATE ACCOUNT
    // --------------------------------------------------------

    void createAccount(int number)
    {
        accountNumber = number;

        cin.ignore(numeric_limits<streamsize>::max(), '\n');

        cout << "\nEnter customer name: ";
        getline(cin, name);

        while (name.empty())
        {
            cout << "Name cannot be empty. Enter again: ";
            getline(cin, name);
        }

        cout << "Enter address: ";
        getline(cin, address);

        while (address.empty())
        {
            cout << "Address cannot be empty. Enter again: ";
            getline(cin, address);
        }

        cout << "Enter city, state, ZIP: ";
        getline(cin, cityStateZip);

        while (cityStateZip.empty())
        {
            cout << "City/State/ZIP cannot be empty. Enter again: ";
            getline(cin, cityStateZip);
        }

        cout << "Enter phone number: ";
        getline(cin, phone);

        while (phone.empty())
        {
            cout << "Phone number cannot be empty. Enter again: ";
            getline(cin, phone);
        }

        // Starting balance
        do
        {
            cout << "Enter starting balance: $";

            while (!(cin >> balance))
            {
                cout << "Invalid amount. Enter a number: ";

                cin.clear();
                cin.ignore(
                    numeric_limits<streamsize>::max(),
                    '\n'
                );
            }

            if (balance < 0)
            {
                cout << "Balance cannot be negative.\n";
            }

        } while (balance < 0);

        cin.ignore(numeric_limits<streamsize>::max(), '\n');

        cout << "Enter last payment date: ";
        getline(cin, lastPaymentDate);

        if (lastPaymentDate.empty())
        {
            lastPaymentDate = "No payment yet";
        }

        active = true;

        cout << "\n====================================\n";
        cout << "ACCOUNT CREATED SUCCESSFULLY!\n";
        cout << "Account Number: " << accountNumber << endl;
        cout << "====================================\n";
    }

    // --------------------------------------------------------
    // DISPLAY ACCOUNT
    // --------------------------------------------------------

    void displayAccount() const
    {
        if (!active)
            return;

        cout << "\n--------------------------------------\n";
        cout << "Account Number: " << accountNumber << endl;
        cout << "Name: " << name << endl;
        cout << "Address: " << address << endl;
        cout << "City/State/ZIP: " << cityStateZip << endl;
        cout << "Phone: " << phone << endl;

        cout << fixed << setprecision(2);
        cout << "Balance: $" << balance << endl;

        cout << "Last Payment: "
             << lastPaymentDate << endl;

        cout << "Status: ACTIVE" << endl;

        cout << "--------------------------------------\n";
    }

    // --------------------------------------------------------
    // EDIT ACCOUNT
    // --------------------------------------------------------

    void editAccount()
    {
        if (!active)
            return;

        cin.ignore(numeric_limits<streamsize>::max(), '\n');

        cout << "\nEditing Account #" << accountNumber << endl;

        cout << "Enter new name: ";
        getline(cin, name);

        while (name.empty())
        {
            cout << "Name cannot be empty. Enter again: ";
            getline(cin, name);
        }

        cout << "Enter new address: ";
        getline(cin, address);

        cout << "Enter new city, state, ZIP: ";
        getline(cin, cityStateZip);

        cout << "Enter new phone number: ";
        getline(cin, phone);

        cout << "\nAccount updated successfully!\n";
    }

    // --------------------------------------------------------
    // DEPOSIT
    // --------------------------------------------------------

    void deposit()
    {
        if (!active)
            return;

        double amount;

        cout << "\nEnter deposit amount: $";

        while (!(cin >> amount) || amount <= 0)
        {
            cout << "Enter a valid positive amount: ";

            cin.clear();
            cin.ignore(
                numeric_limits<streamsize>::max(),
                '\n'
            );
        }

        balance += amount;

        cout << fixed << setprecision(2);

        cout << "\nDeposit successful!\n";
        cout << "New Balance: $" << balance << endl;
    }

    // --------------------------------------------------------
    // MAKE PAYMENT
    // --------------------------------------------------------

    void makePayment()
    {
        if (!active)
            return;

        double amount;

        cout << "\nEnter payment amount: $";

        while (!(cin >> amount) || amount <= 0)
        {
            cout << "Enter a valid positive amount: ";

            cin.clear();
            cin.ignore(
                numeric_limits<streamsize>::max(),
                '\n'
            );
        }

        if (amount > balance)
        {
            cout << "\n❌ Payment cannot be greater than balance.\n";
            return;
        }

        balance -= amount;

        cin.ignore(
            numeric_limits<streamsize>::max(),
            '\n'
        );

        cout << "Enter payment date: ";
        getline(cin, lastPaymentDate);

        cout << fixed << setprecision(2);

        cout << "\nPayment successful!\n";
        cout << "New Balance: $" << balance << endl;
    }

    // --------------------------------------------------------
    // DELETE ACCOUNT
    // --------------------------------------------------------

    void deleteAccount()
    {
        if (!active)
            return;

        active = false;

        cout << "\nAccount deleted successfully.\n";
    }

    // --------------------------------------------------------
    // CHECK ACCOUNT
    // --------------------------------------------------------

    bool isActive() const
    {
        return active;
    }

    int getAccountNumber() const
    {
        return accountNumber;
    }
};


// ============================================================
// FIND ACCOUNT
// ============================================================

int findAccount(
    CustomerAccount accounts[],
    int size,
    int accountNumber
)
{
    for (int i = 0; i < size; i++)
    {
        if (
            accounts[i].isActive() &&
            accounts[i].getAccountNumber() == accountNumber
        )
        {
            return i;
        }
    }

    return -1;
}


// ============================================================
// DISPLAY MENU
// ============================================================

void displayMenu()
{
    cout << "\n";
    cout << "============================================\n";
    cout << "       CUSTOMER ACCOUNT MANAGEMENT\n";
    cout << "============================================\n";

    cout << "1. Add New Customer\n";
    cout << "2. Search Customer\n";
    cout << "3. Display All Customers\n";
    cout << "4. Edit Customer\n";
    cout << "5. Deposit Money\n";
    cout << "6. Make Payment\n";
    cout << "7. Delete Customer\n";
    cout << "8. Exit\n";

    cout << "============================================\n";
}


// ============================================================
// MAIN
// ============================================================

int main()
{
    CustomerAccount accounts[SIZE];

    int choice;

    int nextAccountNumber = 1001;

    do
    {
        displayMenu();

        cout << "Enter your choice: ";

        while (!(cin >> choice) || choice < 1 || choice > 8)
        {
            cout << "Invalid choice. Enter 1-8: ";

            cin.clear();

            cin.ignore(
                numeric_limits<streamsize>::max(),
                '\n'
            );
        }

        // ====================================================
        // ADD CUSTOMER
        // ====================================================

        if (choice == 1)
        {
            int emptySlot = -1;

            for (int i = 0; i < SIZE; i++)
            {
                if (!accounts[i].isActive())
                {
                    emptySlot = i;
                    break;
                }
            }

            if (emptySlot == -1)
            {
                cout << "\n❌ Maximum of "
                     << SIZE
                     << " accounts reached.\n";
            }
            else
            {
                accounts[emptySlot].createAccount(
                    nextAccountNumber
                );

                nextAccountNumber++;
            }
        }

        // ====================================================
        // SEARCH CUSTOMER
        // ====================================================

        else if (choice == 2)
        {
            int accountNumber;

            cout << "\nEnter account number: ";
            cin >> accountNumber;

            int index = findAccount(
                accounts,
                SIZE,
                accountNumber
            );

            if (index == -1)
            {
                cout << "\n❌ Account not found.\n";
            }
            else
            {
                accounts[index].displayAccount();
            }
        }

        // ====================================================
        // DISPLAY ALL
        // ====================================================

        else if (choice == 3)
        {
            bool found = false;

            cout << "\n============================================\n";
            cout << "              ALL CUSTOMERS\n";
            cout << "============================================\n";

            for (int i = 0; i < SIZE; i++)
            {
                if (accounts[i].isActive())
                {
                    accounts[i].displayAccount();
                    found = true;
                }
            }

            if (!found)
            {
                cout << "No customer accounts found.\n";
            }
        }

        // ====================================================
        // EDIT CUSTOMER
        // ====================================================

        else if (choice == 4)
        {
            int accountNumber;

            cout << "\nEnter account number: ";
            cin >> accountNumber;

            int index = findAccount(
                accounts,
                SIZE,
                accountNumber
            );

            if (index == -1)
            {
                cout << "\n❌ Account not found.\n";
            }
            else
            {
                accounts[index].editAccount();
            }
        }

        // ====================================================
        // DEPOSIT
        // ====================================================

        else if (choice == 5)
        {
            int accountNumber;

            cout << "\nEnter account number: ";
            cin >> accountNumber;

            int index = findAccount(
                accounts,
                SIZE,
                accountNumber
            );

            if (index == -1)
            {
                cout << "\n❌ Account not found.\n";
            }
            else
            {
                accounts[index].deposit();
            }
        }

        // ====================================================
        // PAYMENT
        // ====================================================

        else if (choice == 6)
        {
            int accountNumber;

            cout << "\nEnter account number: ";
            cin >> accountNumber;

            int index = findAccount(
                accounts,
                SIZE,
                accountNumber
            );

            if (index == -1)
            {
                cout << "\n❌ Account not found.\n";
            }
            else
            {
                accounts[index].makePayment();
            }
        }

        // ====================================================
        // DELETE CUSTOMER
        // ====================================================

        else if (choice == 7)
        {
            int accountNumber;

            cout << "\nEnter account number: ";
            cin >> accountNumber;

            int index = findAccount(
                accounts,
                SIZE,
                accountNumber
            );

            if (index == -1)
            {
                cout << "\n❌ Account not found.\n";
            }
            else
            {
                char confirm;

                cout << "Are you sure you want to delete "
                     << "this account? (Y/N): ";

                cin >> confirm;

                if (
                    confirm == 'Y' ||
                    confirm == 'y'
                )
                {
                    accounts[index].deleteAccount();
                }
                else
                {
                    cout << "Account was not deleted.\n";
                }
            }
        }

        // ====================================================
        // EXIT
        // ====================================================

        else if (choice == 8)
        {
            cout << "\n============================================\n";
            cout << "Thank you for using Customer Account System!\n";
            cout << "Goodbye!\n";
            cout << "============================================\n";
        }

    } while (choice != 8);

    return 0;
}
