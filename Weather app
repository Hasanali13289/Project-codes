    # ======================================================
    # CREATE DETAIL CARD
    # ======================================================

    def create_detail(
        self,
        parent,
        title,
        value
    ):

        frame = tk.Frame(
            parent,
            bg=CARD_COLOR,
            width=190,
            height=75
        )

        frame.pack(
            side="left",
            padx=7
        )

        frame.pack_propagate(False)


        title_label = tk.Label(
            frame,
            text=title,
            font=("Arial", 10),
            bg=CARD_COLOR,
            fg=MUTED_COLOR
        )

        title_label.pack(
            pady=(10, 2)
        )


        value_label = tk.Label(
            frame,
            text=value,
            font=("Arial", 13, "bold"),
            bg=CARD_COLOR,
            fg=TEXT_COLOR
        )

        value_label.pack()


        return value_label


    # ======================================================
    # GET WEATHER
    # ======================================================

    def get_weather(self):

        city = self.city_entry.get().strip()


        if not city:

            messagebox.showwarning(
                "Missing City",
                "Please enter a city name."
            )

            return


        if API_KEY == "YOUR_API_KEY":

            messagebox.showerror(
                "API Key Missing",
                "Please add your OpenWeatherMap API key."
            )

            return


        self.status_label.config(
            text="Loading weather...",
            fg=ACCENT_COLOR
        )

        self.root.update_idletasks()


        try:

            # ----------------------------------------------
            # CURRENT WEATHER
            # ----------------------------------------------

            params = {

                "q": city,

                "appid": API_KEY,

                "units": self.unit
            }


            response = requests.get(
                CURRENT_WEATHER_URL,
                params=params,
                timeout=10
            )


            if response.status_code == 404:

                raise ValueError(
                    "City not found."
                )


            if response.status_code != 200:

                raise ValueError(
                    "Unable to retrieve weather data."
                )


            current = response.json()


            # ----------------------------------------------
            # FORECAST
            # ----------------------------------------------

            forecast_response = requests.get(
                FORECAST_URL,
                params=params,
                timeout=10
            )


            forecast_data = forecast_response.json()


            self.update_current_weather(
                current
            )


            self.update_forecast(
                forecast_data
            )


            self.last_city = city


            self.status_label.config(
                text="Weather updated successfully",
                fg="#4ade80"
            )


        except requests.exceptions.ConnectionError:

            messagebox.showerror(
                "Connection Error",
                "Check your internet connection."
            )


        except requests.exceptions.Timeout:

            messagebox.showerror(
                "Timeout",
                "The weather server took too long to respond."
            )


        except ValueError as error:

            messagebox.showerror(
                "Weather Error",
                str(error)
            )


        except Exception as error:

            messagebox.showerror(
                "Error",
                f"Something went wrong:\n{error}"
            )


    # ======================================================
    # UPDATE CURRENT WEATHER
    # ======================================================

    def update_current_weather(
        self,
        data
    ):

        city = data["name"]

        country = data["sys"]["country"]

        temperature = data["main"]["temp"]

        feels_like = data["main"]["feels_like"]

        humidity = data["main"]["humidity"]

        pressure = data["main"]["pressure"]

        wind_speed = data["wind"]["speed"]

        weather_main = data["weather"][0]["main"]

        description = data["weather"][0]["description"]


        # Location

        self.location_label.config(
            text=f"{city}, {country}"
        )


        # Icon

        icon = WEATHER_ICONS.get(
            weather_main,
            "🌤️"
        )

        self.icon_label.config(
            text=icon
        )


        # Temperature

        symbol = "°F"

        if self.unit == "metric":

            symbol = "°C"


        self.temperature_label.config(
            text=f"{temperature:.0f}{symbol}"
        )


        # Description

        self.description_label.config(
            text=description.title()
        )


        # Details

        self.feels_label.config(
            text=f"{feels_like:.0f}{symbol}"
        )


        self.humidity_label.config(
            text=f"{humidity}%"
        )


        wind_unit = "mph"

        if self.unit == "metric":

            wind_unit = "m/s"


        self.wind_label.config(
            text=f"{wind_speed:.1f} {wind_unit}"
        )


        self.pressure_label.config(
            text=f"{pressure} hPa"
        )


    # ======================================================
    # UPDATE FORECAST
    # ======================================================

    def update_forecast(
        self,
        data
    ):

        # Remove previous cards

        for widget in self.forecast_frame.winfo_children():

            widget.destroy()


        forecast_list = data["list"]


        # Select approximately one forecast
        # every 24 hours

        daily = []

        used_dates = set()


        for item in forecast_list:

            date = item["dt_txt"].split(" ")[0]


            if date not in used_dates:

                daily.append(item)

                used_dates.add(date)


            if len(daily) == 5:

                break


        # Create cards

        for item in daily:

            self.create_forecast_card(
                item
            )


    # ======================================================
    # FORECAST CARD
    # ======================================================

    def create_forecast_card(
        self,
        data
    ):

        frame = tk.Frame(
            self.forecast_frame,
            bg=CARD_COLOR,
            width=160,
            height=130
        )

        frame.pack(
            side="left",
            padx=5
        )

        frame.pack_propagate(False)


        date = datetime.fromtimestamp(
            data["dt"]
        )


        day = date.strftime(
            "%a"
        )


        weather_main = data["weather"][0]["main"]

        icon = WEATHER_ICONS.get(
            weather_main,
            "🌤️"
        )


        temperature = data["main"]["temp"]


        symbol = "°F"

        if self.unit == "metric":

            symbol = "°C"


        day_label = tk.Label(
            frame,
            text=day,
            font=("Arial", 12, "bold"),
            bg=CARD_COLOR,
            fg=TEXT_COLOR
        )

        day_label.pack(
            pady=(10, 2)
        )


        icon_label = tk.Label(
            frame,
            text=icon,
            font=("Arial", 25),
            bg=CARD_COLOR,
            fg=TEXT_COLOR
        )

        icon_label.pack()


        temp_label = tk.Label(
            frame,
            text=f"{temperature:.0f}{symbol}",
            font=("Arial", 13, "bold"),
            bg=CARD_COLOR,
            fg=TEXT_COLOR
        )

        temp_label.pack()


    # ======================================================
    # TOGGLE °F / °C
    # ======================================================

    def toggle_unit(self):

        if self.unit == "imperial":

            self.unit = "metric"

            self.unit_button.config(
                text="°C"
            )

        else:

            self.unit = "imperial"

            self.unit_button.config(
                text="°F"
            )


        if self.last_city:

            self.city_entry.delete(
                0,
                tk.END
            )

            self.city_entry.insert(
                0,
                self.last_city
            )

            self.get_weather()


# ==========================================================
# START APPLICATION
# ==========================================================

if __name__ == "__main__":

    root = tk.Tk()

    app = WeatherApp(
        root
    )

    root.mainloop()
