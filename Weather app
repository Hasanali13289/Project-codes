# ==========================================================
# WEATHER APP
# ==========================================================

class WeatherApp:

    def __init__(self, root):

        self.root = root

        self.root.title("Weather Dashboard")

        self.root.geometry("950x700")

        self.root.configure(
            bg=BG_COLOR
        )

        self.root.resizable(
            False,
            False
        )

        self.unit = "imperial"

        self.last_city = ""

        self.create_interface()

        self.root.bind(
            "<Return>",
            lambda event: self.get_weather()
        )


    # ======================================================
    # CREATE INTERFACE
    # ======================================================

    def create_interface(self):

        # ------------------------------
        # TITLE
        # ------------------------------

        title = tk.Label(
            self.root,
            text="Weather Dashboard",
            font=("Arial", 30, "bold"),
            bg=BG_COLOR,
            fg=TEXT_COLOR
        )

        title.pack(
            pady=(25, 5)
        )


        subtitle = tk.Label(
            self.root,
            text="Real-time weather information",
            font=("Arial", 12),
            bg=BG_COLOR,
            fg=MUTED_COLOR
        )

        subtitle.pack(
            pady=(0, 20)
        )


        # ------------------------------
        # SEARCH BAR
        # ------------------------------

        search_frame = tk.Frame(
            self.root,
            bg=BG_COLOR
        )

        search_frame.pack()


        self.city_entry = tk.Entry(
            search_frame,
            width=32,
            font=("Arial", 15),
            bg=SECONDARY_COLOR,
            fg=TEXT_COLOR,
            insertbackground="white",
            relief="flat"
        )

        self.city_entry.grid(
            row=0,
            column=0,
            padx=8,
            ipady=8
        )


        search_button = tk.Button(
            search_frame,
            text="Search",
            command=self.get_weather,
            font=("Arial", 12, "bold"),
            bg=BUTTON_COLOR,
            fg="white",
            activebackground=ACCENT_COLOR,
            relief="flat",
            padx=20,
            pady=8,
            cursor="hand2"
        )

        search_button.grid(
            row=0,
            column=1,
            padx=5
        )


        # ------------------------------
        # UNIT BUTTON
        # ------------------------------

        self.unit_button = tk.Button(
            search_frame,
            text="°F",
            command=self.toggle_unit,
            font=("Arial", 12, "bold"),
            bg=SECONDARY_COLOR,
            fg="white",
            relief="flat",
            padx=15,
            pady=8,
            cursor="hand2"
        )

        self.unit_button.grid(
            row=0,
            column=2,
            padx=5
        )


        # ------------------------------
        # STATUS
        # ------------------------------

        self.status_label = tk.Label(
            self.root,
            text="Enter a city to get weather",
            font=("Arial", 11),
            bg=BG_COLOR,
            fg=MUTED_COLOR
        )

        self.status_label.pack(
            pady=10
        )


        # ==================================================
        # MAIN WEATHER CARD
        # ==================================================

        self.weather_card = tk.Frame(
            self.root,
            bg=CARD_COLOR,
            width=850,
            height=270
        )

        self.weather_card.pack(
            padx=40,
            pady=10
        )

        self.weather_card.pack_propagate(False)


        # ------------------------------
        # LOCATION
        # ------------------------------

        self.location_label = tk.Label(
            self.weather_card,
            text="Search for a city",
            font=("Arial", 24, "bold"),
            bg=CARD_COLOR,
            fg=TEXT_COLOR
        )

        self.location_label.pack(
            pady=(20, 5)
        )


        # ------------------------------
        # WEATHER ICON
        # ------------------------------

        self.icon_label = tk.Label(
            self.weather_card,
            text="🌤️",
            font=("Arial", 45),
            bg=CARD_COLOR,
            fg=TEXT_COLOR
        )

        self.icon_label.pack()


        # ------------------------------
        # TEMPERATURE
        # ------------------------------

        self.temperature_label = tk.Label(
            self.weather_card,
            text="--°",
            font=("Arial", 45, "bold"),
            bg=CARD_COLOR,
            fg=TEXT_COLOR
        )

        self.temperature_label.pack()


        # ------------------------------
        # DESCRIPTION
        # ------------------------------

        self.description_label = tk.Label(
            self.weather_card,
            text="--",
            font=("Arial", 14),
            bg=CARD_COLOR,
            fg=MUTED_COLOR
        )

        self.description_label.pack()


        # ==================================================
        # WEATHER DETAILS
        # ==================================================

        details_frame = tk.Frame(
            self.root,
            bg=BG_COLOR
        )

        details_frame.pack(
            pady=15
        )


        self.feels_label = self.create_detail(
            details_frame,
            "Feels Like",
            "--"
        )

        self.humidity_label = self.create_detail(
            details_frame,
            "Humidity",
            "--"
        )

        self.wind_label = self.create_detail(
            details_frame,
            "Wind",
            "--"
        )

        self.pressure_label = self.create_detail(
            details_frame,
            "Pressure",
